#version 100

struct m3x2
{
    vec3 r0;
    vec3 r1;
};

struct Block
{
    vec2 scale;
    vec2 pos;
};

uniform Block _block;

varying vec2 vUV;
attribute vec2 uv;
attribute vec2 pos;

void main()
{
    vUV = uv;
    vec3 p = vec3((pos * _block.scale) + _block.pos, 1.0);
    gl_Position = vec4(p, 1.0);
}

